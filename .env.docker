# ---------------------------------------------------------------------------
# Container-network environment for docker-compose.
#
# Read by Compose on the HOST via `--env-file` (see the Makefile). It is never
# copied into an image — .dockerignore excludes every .env* file on purpose,
# because packages/db/seed.ts lets an on-disk .env override real environment
# variables and would otherwise point seeding at the wrong database host.
#
# Nothing here is a real secret: these are local development defaults. Change
# SESSION_SECRET and POSTGRES_PASSWORD before exposing the stack anywhere.
# ---------------------------------------------------------------------------

# --- Postgres container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prodchi

# --- Host port publishing ---
# 5433, not 5432: a Postgres.app server usually owns 5432 on a dev machine.
DB_PORT=5433
API_PORT=4000
WEB_PORT=3000

# --- API container ---
# Host `db` (the Compose service), never localhost: inside the network the API
# reaches Postgres by service name.
DATABASE_URL=postgresql://postgres:postgres@db:5432/prodchi
SESSION_SECRET=dev-secret-change-in-production
LIARA_BASE_URL=
LIARA_API_KEY=
LIARA_CHAT_MODEL=openai/gpt-4o-mini
ADMIN_SEED_EMAIL=admin@prodchi.local
ADMIN_SEED_PASSWORD=admin123
# CORS origin for the browser -> API calls.
WEB_URL=http://localhost:3000
PORT=4000
# The API image sets NODE_ENV=production; a Secure session cookie cannot be sent
# over plain http://localhost, which looks exactly like a failed login. Set
# COOKIE_SECURE=true once the stack is behind TLS.
COOKIE_SECURE=false

# --- Web container ---
# Browser-facing API URL: inlined into the client bundle at BUILD time.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Server-facing API URL: used by the in-container SSR session lookup
# (apps/web/lib/server-auth.ts). Inside Compose the API answers to `api`.
SERVER_API_URL=http://api:4000/api/v1
NEXT_PUBLIC_ASHKAR_DSN=
NEXT_PUBLIC_ASHKAR_PROJECT_KEY=
NEXT_PUBLIC_ASHKAR_ENVIRONMENT=staging
