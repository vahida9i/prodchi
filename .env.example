DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prodchi
SESSION_SECRET=dev-secret-change-in-production
ADMIN_SEED_EMAIL=admin@prodchi.local
ADMIN_SEED_PASSWORD=admin123
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# UI locale: 'en' or 'fa'. Decided once at build/startup — no runtime switching.
# NEXT_PUBLIC_* is inlined into the client bundle at build time; APP_LOCALE is
# read server-side (seed, SSR, shared-types). Set both to the same value.
APP_LOCALE=en
NEXT_PUBLIC_APP_LOCALE=en
NEXT_PUBLIC_ASHKAR_DSN=
NEXT_PUBLIC_ASHKAR_PROJECT_KEY=
NEXT_PUBLIC_ASHKAR_ENVIRONMENT=staging
WEB_URL=http://localhost:3000
PORT=4000