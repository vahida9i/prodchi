{
  "name": "@baaten/shared-types",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./challenge-schema": {
      "types": "./dist/challenge-schema.d.ts",
      "default": "./dist/challenge-schema.js"
    },
    "./validator": {
