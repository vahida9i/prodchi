      "default": "./dist/validator.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@prisma/client": "^5.12.0",
    "typescript": "^5.4.0"
  }
}